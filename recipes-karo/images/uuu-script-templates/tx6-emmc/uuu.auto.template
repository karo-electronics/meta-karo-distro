uuu_version 1.5.21

# i.MX6 eMMC. Generated from template - do not edit.

### boot U-Boot with fastboot support
SDP: boot -f $image_bootloader-$machine-mfg.$uboot_suffix

# Refuse a foreign SoC before writing anything.
FB: ucmd karo_chksoc

# enable boot from eMMC and switch to boot partition
FB: ucmd mmc partconf $${emmc_dev} $${emmc_boot_ack} $${emmc_boot_part} $${emmc_boot_part}

# Zero the stored env; an erase would widen to 4MiB.
FB: ucmd mw.b $${loadaddr} 0 0x1000
FB: ucmd mmc write $${loadaddr} 0xff8 0x8

# bootloader: the ROM reads the IVT at sector 2
# fastboot buffer equals loadaddr on every i.MX6 module
FB: download -f $image_bootloader-$machine-default.$uboot_suffix
FB: ucmd setexpr fb_blk $${filesize} + 0x1ff
FB: ucmd setexpr fb_blk $${fb_blk} / 0x200
FB: ucmd mmc write $${loadaddr} 0x2 $${fb_blk}

# switch to eMMC user partition
FB: ucmd mmc partconf $${emmc_dev} $${emmc_boot_ack} $${emmc_boot_part} 0

### Flashing partitions
$flash_cmds

### return to U-Boot prompt
FB: continue
FB: done
