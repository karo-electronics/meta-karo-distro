[boot]
mode=ubi
image=@WORKDIR@/boot.ubifs
vol_id=0
vol_size=@BOOTFS_PARTITION_SIZE@KiB
vol_type=dynamic
vol_name=boot
[rootfs]
mode=ubi
image=@WORKDIR@/rootfs.ubifs
vol_id=1
vol_size=@ROOTFS_PARTITION_SIZE@KiB
vol_type=dynamic
vol_name=rootfs
[userfs]
mode=ubi
image=@WORKDIR@/userfs.ubifs
vol_id=2
vol_size=@USERFS_PARTITION_SIZE@KiB
vol_type=dynamic
vol_name=userfs
@USERFS_VOL_FLAGS@
