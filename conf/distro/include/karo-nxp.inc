PREFERRED_PROVIDER_opencl-headers = "imx-gpu-viv"

# override default settings from meta-imx/.../imx-base-extend.inc ...
GSTREAMER_VERSION ?= "1.22.0.imx"
PREFERRED_VERSION_gstreamer1.0:mx8-nxp-bsp = "${GSTREAMER_VERSION}"
PREFERRED_VERSION_gstreamer1.0-plugins-base:mx8-nxp-bsp = "${GSTREAMER_VERSION}"
PREFERRED_VERSION_gstreamer1.0-plugins-good:mx8-nxp-bsp = "${GSTREAMER_VERSION}"
PREFERRED_VERSION_gstreamer1.0-plugins-bad:mx8-nxp-bsp = "${GSTREAMER_VERSION}"
PREFERRED_VERSION_gstreamer1.0-rtsp-server:mx8-nxp-bsp = "${GSTREAMER_VERSION}"
PREFERRED_VERSION_gstreamer1.0:mx9-nxp-bsp = "${GSTREAMER_VERSION}"
PREFERRED_VERSION_gstreamer1.0-plugins-base:mx9-nxp-bsp = "${GSTREAMER_VERSION}"
PREFERRED_VERSION_gstreamer1.0-plugins-good:mx9-nxp-bsp = "${GSTREAMER_VERSION}"
PREFERRED_VERSION_gstreamer1.0-plugins-bad:mx9-nxp-bsp = "${GSTREAMER_VERSION}"
PREFERRED_VERSION_gstreamer1.0-rtsp-server:mx9-nxp-bsp = "${GSTREAMER_VERSION}"
# ... and meta-freescale/.../imx-base.inc
PREFERRED_VERSION_gst-devtools:mx8-nxp-bsp              = "${GSTREAMER_VERSION}"
PREFERRED_VERSION_gstreamer1.0-libav:mx8-nxp-bsp        = "${GSTREAMER_VERSION}"
PREFERRED_VERSION_gstreamer1.0-plugins-ugly:mx8-nxp-bsp = "${GSTREAMER_VERSION}"
PREFERRED_VERSION_gstreamer1.0-python:mx8-nxp-bsp       = "${GSTREAMER_VERSION}"
PREFERRED_VERSION_gstreamer1.0-rtsp-server:mx8-nxp-bsp  = "${GSTREAMER_VERSION}"
PREFERRED_VERSION_gstreamer1.0-vaapi:mx8-nxp-bsp        = "${GSTREAMER_VERSION}"
PREFERRED_VERSION_gst-devtools:mx9-nxp-bsp              = "${GSTREAMER_VERSION}"
PREFERRED_VERSION_gstreamer1.0-libav:mx9-nxp-bsp        = "${GSTREAMER_VERSION}"
PREFERRED_VERSION_gstreamer1.0-plugins-ugly:mx9-nxp-bsp = "${GSTREAMER_VERSION}"
PREFERRED_VERSION_gstreamer1.0-python:mx9-nxp-bsp       = "${GSTREAMER_VERSION}"
