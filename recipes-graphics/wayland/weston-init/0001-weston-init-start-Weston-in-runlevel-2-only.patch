From c01c72d67823e9a491d14156cb7ef26a7302ab13 Mon Sep 17 00:00:00 2001
From: Robin Lintermann <rl@karo-electronics.de>
Date: Fri, 30 Oct 2026 10:45:27 +0000
Subject: [PATCH] weston-init: start Weston in runlevel 2 only

On the Ka-Ro images Weston is the defining feature of the default
runlevel (2); in the other multi-user runlevels the compositor stays
down so the system console remains usable.

Upstream-Status: Inappropriate [karo specific]

Signed-off-by: Robin Lintermann <rl@karo-electronics.de>
---
 init | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/init b/init
index a5c54e0..3d4118e 100644
--- a/init
+++ b/init
@@ -4,8 +4,8 @@
 # Provides: weston
 # Required-Start: $local_fs $remote_fs
 # Required-Stop: $local_fs $remote_fs
-# Default-Start:     2 3 4 5
-# Default-Stop:      0 1 6
+# Default-Start:     2
+# Default-Stop:      0 1 3 4 5 6
 ### END INIT INFO
 
 if test -e /etc/default/weston ; then
@@ -30,7 +30,7 @@ done
 case "$1" in
   start)
         . /etc/profile
-	      export HOME=ROOTHOME
+	export HOME=ROOTHOME
 
         WESTON_USER=weston weston-start $OPTARGS &
   ;;
-- 
2.43.0

