index 7fc19c8..35aebd4 100755
--- a/functions
+++ b/functions
@@ -92,24 +92,3 @@ passed() {
     echo -n -e "${BRACKET}[${SUCCESS} PASS ${BRACKET}]${NORMAL}"
     return $rc
 }
