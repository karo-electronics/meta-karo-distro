diff --git a/mountall.sh b/mountall.sh
old mode 100755
new mode 100644
index e87b291..06415cf
--- a/mountall.sh
+++ b/mountall.sh
@@ -5,8 +5,8 @@
 
 ### BEGIN INIT INFO
 # Provides:          mountall
-# Required-Start:    mountvirtfs
-# Required-Stop: 
+# Required-Start:    checkroot checkfs mountvirtfs
+# Required-Stop:
 # Default-Start:     S
 # Default-Stop:
 # Short-Description: Mount all filesystems.
@@ -21,22 +21,20 @@
 # about this. So we mount "proc" filesystems without -v.
 #
 test "$VERBOSE" != no && echo "Mounting local filesystems..."
-mount -at nonfs,nosmbfs,noncpfs 2>/dev/null
+mount -at nonfs,smbfs,ncpfs 2>/dev/null
 
 
 # We might have mounted something over /run; see if
-# /dev/initctl is present.  Look for
-# /sbin/init.sysvinit to verify that sysvinit (and
-# not busybox or systemd) is installed as default init).
-INITCTL="/dev/initctl"
+# /run/initctl is present.
+# Verify that sysvinit (and not busybox or systemd) is installed as default init).
+INITCTL="/run/initctl"
 if [ ! -p "$INITCTL" ] && [ "${INIT_SYSTEM}" = "sysvinit" ]; then
     # Create new control channel
-		rm -f "$INITCTL"
-		mknod -m 600 "$INITCTL" p
+    rm -f "$INITCTL"
+    mknod -m 600 "$INITCTL" p
 
-		# Reopen control channel.
-		PID="$(pidof -s /sbin/init || echo 1)"
-		[ -n "$PID" ] && kill -s USR1 "$PID"
+    # Reopen control channel.
+    kill -s USR1 1
 fi
 
 #
@@ -44,6 +42,3 @@ fi
 # a file on a now mounted filesystem.
 #
 [ -x /sbin/swapon ] && swapon -a
-
-: exit 0
-
diff --git a/reboot b/reboot
old mode 100755
new mode 100644
index 91e3972..adb58a7
--- a/reboot
+++ b/reboot
@@ -15,5 +15,37 @@
 
 PATH=/sbin:/bin:/usr/sbin:/usr/bin
 
-echo -n "Rebooting... "
-reboot SED_HALTARGS
+. /etc/default/rcS
+
+do_stop () {
+	# Message should end with a newline since kFreeBSD may
+	# print more stuff (see #323749)
+	[ $VERBOSE = no ] || echo "Will now restart"
+
+	netdown=""
+	if sed -n 's/^[^ ]* \([^ ]*\) \([^ ]*\) .*$/\1 \2/p' /proc/mounts | grep -q "^/ nfs$";then
+		echo "NOT shutting down network interfaces: / is an NFS mount"
+	elif sed -n 's/^[^ ]* \([^ ]*\) \([^ ]*\) .*$/\2/p' /proc/mounts | grep -qE '^(nfs|smbfs)$';then
+		echo "NOT shutting down network interfaces: NFS/SMB shares still mounted."
+	else
+		netdown=-i
+	fi
+	reboot -d -f $netdown
+}
+
+case "$1" in
+  start)
+	# No-op
+	;;
+  restart|reload|force-reload)
+	echo "Error: argument '$1' not supported" >&2
+	exit 3
+	;;
+  stop)
+	do_stop
+	;;
+  *)
+	echo "Usage: $0 start|stop" >&2
+	exit 3
+	;;
+esac
diff --git a/umountfs b/umountfs
old mode 100755
new mode 100644
index a8691e5..16a72ff
--- a/umountfs
+++ b/umountfs
@@ -6,7 +6,7 @@
 ### BEGIN INIT INFO
 # Provides:          umountfs
 # Required-Start:
-# Required-Stop:     
+# Required-Stop:
 # Default-Start:
 # Default-Stop:      0 6
 # Short-Description: Turn off swap and unmount all local file systems.
@@ -15,14 +15,31 @@
 
 PATH=/sbin:/bin:/usr/sbin:/usr/bin
 
+# make changes to certain tmp directories persistent
+if [ -d /etc/.var -a -n "$(ls /etc/.var/)" ];then
+    mount /etc/.var -o remount,rw
+    for d in tmp/ lib/ log/wtmp;do
+	rsync -avu --delete "/var/$d" "/etc/.var/$d"
+    done
+    mount /etc/.var -o remount,rw
+fi
+
+umount -f -a -t tmpfs
+
 echo "Deactivating swap..."
 [ -x /sbin/swapoff ] && swapoff -a
 
-# We leave /proc mounted.
 echo "Unmounting local filesystems..."
 grep -q /mnt/ram /proc/mounts && mount -o remount,ro /mnt/ram
 mount -o remount,ro /
 
-umount -f -a -r > /dev/null 2>&1
+netmnt=""
+if sed -n 's/^[^ ]* \([^ ]*\) \([^ ]*\) .*$/\1 \2/p' /proc/mounts | grep -q "^/ nfs$";then
+    echo "NOT unmounting NFS filesystems due to NFSROOT"
+    netmnt=,nfs
+fi
+
+umount -f -a -r -t nodevpts,devtmpfs,proc,sysfs,tmpfs,usbfs${netmnt}
+mount
 
 : exit 0
