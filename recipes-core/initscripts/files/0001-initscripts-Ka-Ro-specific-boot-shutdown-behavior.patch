From 29fdbd0dc398900ba6de0bdbed51269be17324d1 Mon Sep 17 00:00:00 2001
From: Robin Lintermann <rl@karo-electronics.de>
Date: Fri, 30 Oct 2026 10:35:26 +0000
Subject: [PATCH] initscripts: Ka-Ro specific boot/shutdown behavior

- bootmisc.sh: create /run/utmp with utmp group ownership, keep the
  nologin flag file on the persistent /var/lib/initscripts tree, use
  the shared vars.sh sourcing point (@@LIBDIR@@ placeholder) and skip
  work that other recipes own on Ka-Ro images (motd, timestamp, sysctl,
  hwclock)
- checkroot.sh: drop the fstab/rcS writability warning
- mountall.sh: use /run/initctl as the sysvinit control channel
- reboot: bring interfaces down on shutdown unless NFS mounts require
  them up (replaces the SED_HALTARGS stub)
- umountfs: persist selected /var trees to /etc/.var, unmount tmpfs
  explicitly and keep NFS mounts alive for NFS-root systems
- functions: drop the unused log_*_msg helpers

Upstream-Status: Inappropriate [karo specific]

Signed-off-by: Robin Lintermann <rl@karo-electronics.de>
---
 bootmisc.sh  | 123 ++++++++++++++++++++++-----------------------------
 checkroot.sh |  14 +-----
 functions    |  21 ---------
 mountall.sh  |  25 +++++------
 reboot       |  36 ++++++++++++++-
 umountfs     |  23 ++++++++--
 6 files changed, 118 insertions(+), 124 deletions(-)
 mode change 100755 => 100644 bootmisc.sh
 mode change 100755 => 100644 checkroot.sh
 mode change 100755 => 100644 mountall.sh
 mode change 100755 => 100644 reboot
 mode change 100755 => 100644 umountfs

diff --git a/bootmisc.sh b/bootmisc.sh
old mode 100755
new mode 100644
index 6068a8c..7806ee4
--- a/bootmisc.sh
+++ b/bootmisc.sh
@@ -5,84 +5,65 @@
 
 ### BEGIN INIT INFO
 # Provides:          bootmisc
-# Required-Start:    $local_fs mountvirtfs
-# Required-Stop:     $local_fs
+# Required-Start:    $remote_fs
+# Required-Stop:
+# Should-Start:      udev
 # Default-Start:     S
-# Default-Stop:      0 6
-# Short-Description: Misc and other.
+# Default-Stop:
+# Short-Description: Miscellaneous things to be done during bootup.
+# Description:       Some cleanup.  Note, it need to run after mountnfs-bootclean.sh.
 ### END INIT INFO
 
-TIMESTAMP_FILE=/etc/timestamp
+PATH=/sbin:/usr/sbin:/bin:/usr/bin
+[ "$DELAYLOGIN" ] || DELAYLOGIN=yes
+. @@LIBDIR@@/init/vars.sh
 
-. /etc/default/rcS
-[ -f /etc/default/timestamp ] && . /etc/default/timestamp
-#
-# Put a nologin file in /etc to prevent people from logging in before
-# system startup is complete.
-#
-if test "$DELAYLOGIN" = yes
-then
-  echo "System bootup in progress - please wait" > /etc/nologin
-  cp /etc/nologin /etc/nologin.boot
-fi
+do_start () {
+	#
+	# If login delaying is enabled then create the flag file
+	# which prevents logins before startup is complete
+	#
+	case "$DELAYLOGIN" in
+	  Y*|y*)
+		echo "System bootup in progress - please wait" > /var/lib/initscripts/nologin
+		;;
+	esac
 
-#
-# Set pseudo-terminal access permissions.
-#
-if test -c /dev/ttyp0
-then
-	chmod 666 /dev/tty[p-za-e][0-9a-f]
-	chown root:tty /dev/tty[p-za-e][0-9a-f]
-fi
+	# Create /run/utmp so we can login.
+	: > /run/utmp
+	if grep -q ^utmp: /etc/group
+	then
+		chmod 664 /run/utmp
+		chgrp utmp /run/utmp
+	fi
 
-#
-# Apply /proc settings if defined
-#
-SYSCTL_CONF="/etc/sysctl.conf"
-if [ -f "${SYSCTL_CONF}" ]
-then
-	if [ -x "/sbin/sysctl" ]
+	# Set pseudo-terminal access permissions.
+	if [ ! -e /dev/.udev ] && [ -c /dev/ttyp0 ]
 	then
-		# busybox sysctl does not support -q
-		VERBOSE_REDIR="1>/dev/null"
-		if [ "${VERBOSE}" != "no" ]; then
-			VERBOSE_REDIR="1>&1"
-		fi
-		eval /sbin/sysctl -p "${SYSCTL_CONF}" $VERBOSE_REDIR
-	else
-		echo "To have ${SYSCTL_CONF} applied during boot, install package <procps>."
+		chmod -f 666 /dev/tty[p-za-e][0-9a-f]
+		chown -f root:tty /dev/tty[p-za-e][0-9a-f]
 	fi
-fi
 
-#
-# Update /etc/motd.
-#
-if test "$EDITMOTD" != no
-then
-	uname -a > /etc/motd.tmp
-	sed 1d /etc/motd >> /etc/motd.tmp
-	mv /etc/motd.tmp /etc/motd
-fi
+	# Remove bootclean's flag files.
+	# Don't run bootclean again after this!
+	rm -f /tmp/.clean /run/.clean /var/lock/.clean
+}
 
-#
-# This is as good a place as any for a sanity check
-#
-# Set the system clock from hardware clock
-# If the timestamp is more recent than the current time,
-# use the timestamp instead.
-test -x /etc/init.d/hwclock.sh && /etc/init.d/hwclock.sh start
-if test -e "$TIMESTAMP_FILE"
-then
-	SYSTEMDATE=`date -u +%4Y%2m%2d%2H%2M%2S`
-	read TIMESTAMP < "$TIMESTAMP_FILE"
-	if [ ${TIMESTAMP} -gt $SYSTEMDATE ]; then
-		# format the timestamp as date expects it (2m2d2H2M4Y.2S)
-		TS_YR=${TIMESTAMP%??????????}
-		TS_SEC=${TIMESTAMP#????????????}
-		TS_FIRST12=${TIMESTAMP%??}
-		TS_MIDDLE8=${TS_FIRST12#????}
-		date -u ${TS_MIDDLE8}${TS_YR}.${TS_SEC}
-		test -x /etc/init.d/hwclock.sh && /etc/init.d/hwclock.sh stop
-	fi
-fi
-: exit 0
+case "$1" in
+  start|"")
+	do_start
+	;;
+  restart|reload|force-reload)
+	echo "Error: argument '$1' not supported" >&2
+	exit 3
+	;;
+  stop)
+	# No-op
+	;;
+  *)
+	echo "Usage: bootmisc.sh [start|stop]" >&2
+	exit 3
+	;;
+esac
+
+:
diff --git a/checkroot.sh b/checkroot.sh
old mode 100755
new mode 100644
index 1c7057b..5e8917c
--- a/checkroot.sh
+++ b/checkroot.sh
@@ -6,7 +6,7 @@
 ### BEGIN INIT INFO
 # Provides:          checkroot
 # Required-Start:    udev
-# Required-Stop:     
+# Required-Stop:
 # Default-Start:     S
 # Default-Stop:
 # Short-Description: Check to root file system.
@@ -58,16 +58,6 @@ do
 done
 exec 0>&9 9>&-
 
-# Check for conflicting configurations
-if [ "$rootmode" = "ro" -a "$ROOTFS_READ_ONLY" = "no" ] || \
-	[ "$rootmode" = "rw" -a "$ROOTFS_READ_ONLY" = "yes" ]; then
-	echo ""
-	echo "WARN: conflicting configurations in /etc/fstab and /etc/default/rcS"
-	echo "      regarding the writability of rootfs. Please fix one of them."
-	echo ""
-fi
-
-
 #
 # Activate the swap device(s) in /etc/fstab. This needs to be done
 # before fsck, since fsck can be quite memory-hungry.
@@ -78,7 +68,7 @@ test "$VERBOSE" != no && echo "Activating swap"
 #
 # Check the root filesystem.
 #
-if test -f /fastboot || test "$rootcheck" = "no"
+if test -f /fastboot || test $rootcheck = no
 then
   test $rootcheck = yes && echo "Fast boot, no filesystem check"
 else
