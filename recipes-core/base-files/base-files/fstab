# BEGIN-DEV-NOTE
# When using wic to create and partition images, all partitions defined
# in the .wks file are added to the /etc/fstab of the target image
# automatically. Mount options can be configured per partition in the .wks
# file with the --fsoptions=<options> parameter of the 'part' command.
# This note is for reference only and is removed from the fstab installed in
# the target image by the base-files recipe.
# END-DEV-NOTE
# device		dir			type		options		dump	fsck

/dev/root       /           auto        defaults    0       1
proc			/proc		proc		defaults	0		0
sysfs			/sys		sysfs		defaults	0		0
devtmpfs		/dev		devtmpfs	defaults	0		0
devpts			/dev/pts	devpts		mode=0620,gid=5	0	0
tmpfs			/run		tmpfs		mode=0755,nodev,nosuid,strictatime	0	0
tmpfs			/var/volatile	tmpfs		defaults	0		0
