# short-description: Create disk image with partitions and bootloader for KARO boards
# long-description:
# Create a disk image that can be written onto storage (SD card, eMMC, etc.)
# for use with KARO boards.
#
# The disk layout includes:
#  - Boot filesystem partition
#  - Root filesystem partition
#  - User filesystem partition

# Boot filesystem partition
# U-Boot ext4 write: no metadata_csum, no dir_index
part /boot --source karo_bootimg_partition --ondisk mmcblk0 --fstype=ext4 --mkfs-extraopts "-F -i 4096 -O ^metadata_csum,^dir_index" --label boot --use-label --fsoptions noauto --active --align 1024 --fixed-size ${BOOTFS_PARTITION_SIZE}k

# Root filesystem partition
part / --source karo_rootfs --ondisk mmcblk0 --fstype=ext4 --label rootfs --use-label --align 1024 --fixed-size ${ROOTFS_PARTITION_SIZE}k --exclude-path usr/local/

# User filesystem partition
part /usr/local --source karo_rootfs --rootfs-dir=${IMAGE_ROOTFS}/usr/local --ondisk mmcblk0 --fstype=ext4 --label userfs --use-label --align 1024 --fixed-size ${USERFS_PARTITION_SIZE}k

bootloader --ptable gpt
